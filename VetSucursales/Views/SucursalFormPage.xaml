<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VetSucursales.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="VetSucursales.Views.SucursalFormPage"
             x:DataType="vm:SucursalFormViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#9888;" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" FontSize="16" VerticalOptions="Start" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                           FontSize="13"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="Nombre *" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding NombreError, Converter={StaticResource StringToBoolConverter}}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Entry Text="{Binding Nombre}" Placeholder="Nombre de la sucursal">
                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Unfocused" Command="{Binding ValidateFieldsCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
                <Label Text="{Binding NombreError}" Style="{StaticResource FieldErrorLabel}" IsVisible="{Binding NombreError, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Dirección *" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding DireccionError, Converter={StaticResource StringToBoolConverter}}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Entry Text="{Binding Direccion}" Placeholder="Dirección exacta">
                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Unfocused" Command="{Binding ValidateFieldsCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
                <Label Text="{Binding DireccionError}" Style="{StaticResource FieldErrorLabel}" IsVisible="{Binding DireccionError, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Teléfono *" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding TelefonoError, Converter={StaticResource StringToBoolConverter}}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Entry Text="{Binding Telefono}" Placeholder="Ej. 2222-2222" Keyboard="Telephone">
                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Unfocused" Command="{Binding ValidateFieldsCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
                <Label Text="{Binding TelefonoError}" Style="{StaticResource FieldErrorLabel}" IsVisible="{Binding TelefonoError, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Horario de atención *" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HorarioError, Converter={StaticResource StringToBoolConverter}}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Entry Text="{Binding HorarioAtencion}" Placeholder="Ej. Lunes a viernes 8:00 a.m. - 5:00 p.m.">
                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Unfocused" Command="{Binding ValidateFieldsCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
                <Label Text="{Binding HorarioError}" Style="{StaticResource FieldErrorLabel}" IsVisible="{Binding HorarioError, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Encargado *" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding EncargadoError, Converter={StaticResource StringToBoolConverter}}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Entry Text="{Binding Encargado}" Placeholder="Nombre del encargado">
                        <Entry.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Unfocused" Command="{Binding ValidateFieldsCommand}" />
                        </Entry.Behaviors>
                    </Entry>
                </Border>
                <Label Text="{Binding EncargadoError}" Style="{StaticResource FieldErrorLabel}" IsVisible="{Binding EncargadoError, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Descripción *" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}" Padding="12,10">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding DescripcionError, Converter={StaticResource StringToBoolConverter}}" Value="True">
                            <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Editor Text="{Binding Descripcion}" Placeholder="Servicios y detalles de la sucursal" AutoSize="TextChanges" MinimumHeightRequest="80">
                        <Editor.Behaviors>
                            <toolkit:EventToCommandBehavior EventName="Unfocused" Command="{Binding ValidateFieldsCommand}" />
                        </Editor.Behaviors>
                    </Editor>
                </Border>
                <Label Text="{Binding DescripcionError}" Style="{StaticResource FieldErrorLabel}" IsVisible="{Binding DescripcionError, Converter={StaticResource StringToBoolConverter}}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Text="Cancelar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="1"
                        Text="Guardar"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
