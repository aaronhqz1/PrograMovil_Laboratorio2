<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VetSucursales.ViewModels"
             xmlns:helpers="clr-namespace:VetSucursales.Helpers"
             x:Class="VetSucursales.Views.SucursalDetailPage"
             x:DataType="vm:SucursalDetailViewModel"
             Title="Detalle de sucursal">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Border Style="{StaticResource ErrorBanner}" IsVisible="{Binding HasError}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#9888;" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" FontSize="16" VerticalOptions="Start" />
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                           FontSize="13"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="18" IsVisible="{Binding HasSucursal}">

                <!-- Encabezado: avatar + nombre -->
                <HorizontalStackLayout Spacing="14">
                    <Border Style="{StaticResource AvatarBorder}" WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 32">
                        <Label Style="{StaticResource AvatarLabel}" FontSize="24" Text="{Binding Sucursal.Nombre, Converter={StaticResource InitialConverter}}" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="{Binding Sucursal.Nombre}" Style="{StaticResource PageTitle}" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Sucursal.Encargado.NombreCompleto, StringFormat='Encargado: {0}'}" Style="{StaticResource CaptionLabel}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Tarjeta de información -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128205;" FontSize="16" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Dirección" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Sucursal.Direccion, Converter={StaticResource DireccionFormatConverter}}" FontSize="16" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128222;" FontSize="16" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Teléfono" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Sucursal.Telefono}" FontSize="16" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128336;" FontSize="16" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Horario de atención" Style="{StaticResource CaptionLabel}" />
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding HorarioResumen}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="helpers:HorarioResumenItem">
                                            <Grid ColumnDefinitions="90,*">
                                                <Label Grid.Column="0" Text="{Binding NombreDia}" FontSize="14" FontAttributes="Bold" />
                                                <Label Grid.Column="1" Text="{Binding Descripcion}" FontSize="14" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128100;" FontSize="16" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Encargado" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Sucursal.Encargado.NombreCompleto}" FontSize="16" />
                                <Label Text="{Binding Sucursal.Encargado.Telefono}" FontSize="13" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Sucursal.Encargado.Correo}" FontSize="13" Style="{StaticResource CaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

                        <Grid ColumnDefinitions="28,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="&#128221;" FontSize="16" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Descripción" Style="{StaticResource CaptionLabel}" />
                                <Label Text="{Binding Sucursal.Descripcion}" FontSize="16" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Editar" Command="{Binding EditCommand}" />
                    <Button Grid.Column="1"
                            Text="Eliminar"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" />
                </Grid>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
